# ---------------------------------------------------------------------------
# GNL1Z Asset Management Elite — environment variables
#
# Copy to .env and fill in. .env is git-ignored: real values must never be
# committed. This file contains placeholders only (scripts/check-secrets.mjs
# fails CI if that stops being true).
#
# VITE_* variables are BUNDLED INTO THE BROWSER. Only publishable values belong
# here. A Supabase service-role key, a Gemini key or any other server secret
# must be set as a Supabase Edge Function secret or a Cloudflare Pages variable,
# never with a VITE_ prefix.
# ---------------------------------------------------------------------------

# Supabase project (publishable/anonical values — safe to expose to the client)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Canonical origin of the deployed app, used for OAuth redirects.
VITE_APP_URL=https://your-app.pages.dev

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (supabase secrets set NAME=value)
#   GEMINI_API_KEY              gemini vision model for DCS instrument detection
#   ALLOWED_ORIGIN              CORS origin allowed for the edge functions,
#                               e.g. https://your-app.pages.dev. Defaults to *
#                               when unset; set it in production.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloudflare Pages environment (dashboard → Settings → Environment variables)
#   GEMINI_API_KEY              server-side key for /api/ai-agent
#   ALLOWED_ORIGIN              origin echoed by the Pages Functions
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Local tooling only (never deployed)
#   GEMINI_API_KEY              used by `npm run pid:index -- --backend=gemini`
#                               to re-read P&IDs with vision, offline
# ---------------------------------------------------------------------------
